# ═══════════════════════════════════════════════════
# SONIVAULT — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ───────────────────────────────────────────────────
# MongoDB Atlas
# ───────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Clusters → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sonivault
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/sonivault

# ───────────────────────────────────────────────────
# NextAuth v5
# ───────────────────────────────────────────────────
# Secret for signing JWTs — already generated below, use as-is
AUTH_SECRET=cLdki+QzJKABY8rSdy2trRW1rnwB+ulqJwTyip5fL7s=

# App URL — change to production URL on Vercel
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ───────────────────────────────────────────────────
# Gmail SMTP (Nodemailer)
# ───────────────────────────────────────────────────
# Setup:
#   1. Go to myaccount.google.com → Security → 2-Step Verification → App Passwords
#   2. Select app "Mail", device "Other (SONIVAULT)"
#   3. Copy the 16-char generated password → paste below
EMAIL_SERVER_USER=your-gmail@gmail.com
EMAIL_SERVER_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=SONIVAULT <your-gmail@gmail.com>

# ───────────────────────────────────────────────────
# Cloudinary (used in Phase 3 — fill in later)
# ───────────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
